# LLM
OPENAI_API_KEY=sk-your-openai-key-here
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=2048

# Application
APP_NAME=NL2SQL-RAG
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
LOG_LEVEL=INFO

# Internal Postgres (metadata store)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=rag_password
POSTGRES_DB=nl2sql_rag

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=nl2sql_schemas

# Embedding / Reranker
DENSE_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
SPARSE_EMBED_MODEL=prithivida/Splade_PP_en_v1
HYBRID_SEARCH=true
RERANKER_MODEL=ms-marco-MiniLM-L-12-v2

# Target Database (the DB users query in natural language)
TARGET_DB_TYPE=postgresql
TARGET_DB_HOST=localhost
TARGET_DB_PORT=5432
TARGET_DB_USER=db_user
TARGET_DB_PASSWORD=db_password
TARGET_DB_NAME=your_database

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Security
SECRET_KEY=change-me-in-production
API_KEY_HEADER=X-API-Key
